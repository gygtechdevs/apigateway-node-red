PORT=8080

# ─── Platform Backend (fuente única de datos) ─────────────────────────────────
PLATFORM_URL=http://localhost:3000
PLATFORM_TENANT_SLUG=empresa-a
PLATFORM_INTERNAL_SECRET=change-this-secret

# ─── Session Store ─────────────────────────────────────────────────────────────
# Si se define REDIS_URL se usa Redis; si no, se usa almacenamiento en memoria.
# En producción siempre definir REDIS_URL para persistir sesiones entre reinicios.
# REDIS_URL=redis://localhost:6379

# ─── Node-RED ─────────────────────────────────────────────────────────────────
NODE_RED_BASE_URL=http://localhost:1878
NODE_RED_TIMEOUT_MS=10000
GATEWAY_FALLBACK_STEP=/node-red/default
STEPS_SERVICE_BASE_URL=http://localhost:3000
